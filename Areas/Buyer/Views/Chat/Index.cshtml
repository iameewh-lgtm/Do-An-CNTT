@model IEnumerable<ĐồÁnCơSở.Models.Message>

@{
    ViewData["Title"] = "Tin nhắn";
    var allUsers = ViewBag.AllUsers as List<ĐồÁnCơSở.Models.ApplicationUser>;
    string adminId = ViewBag.AdminId;
    string activeChatId = ViewBag.ActiveChatId;
    string currentUserId = ViewBag.CurrentUserId;
}

<div class="container mt-4 mb-5">
    <div class="row bg-white shadow-lg rounded-4 overflow-hidden border" style="height: 75vh;">
        
        <div class="col-md-4 col-lg-3 p-0 border-end bg-light d-flex flex-column h-100">
            <div class="p-3 text-white text-center" style="background: linear-gradient(135deg, #111 0%, #333 100%);">
                <h6 class="mb-0 fw-bold" style="letter-spacing: 1px;"><i class="bi bi-chat-dots me-2"></i>TIN NHẮN</h6>
            </div>
            <div class="overflow-auto flex-grow-1 custom-scrollbar">
                <div class="list-group list-group-flush">
                    
                    <a href="/Buyer/Chat/Index?userId=AI_BOT" class="list-group-item list-group-item-action py-3 @(activeChatId == "AI_BOT" ? "active-chat" : "")">
                        <div class="d-flex align-items-center">
                            <div class="rounded-circle d-flex align-items-center justify-content-center text-white" style="width: 45px; height: 45px; background: linear-gradient(135deg, #FF5000 0%, #FF8C00 100%);">
                                <i class="bi bi-robot fs-5"></i>
                            </div>
                            <div class="ms-3">
                                <h6 class="mb-0 fw-bold text-dark">Trợ lý AI KIMI</h6>
                                <small class="text-muted"><i class="bi bi-pin-angle-fill text-danger"></i> Đã ghim</small>
                            </div>
                        </div>
                    </a>

                    @if (adminId != null && adminId != currentUserId)
                    {
                        var adminUser = allUsers.FirstOrDefault(u => u.Id == adminId);
                        if (adminUser != null)
                        {
                            <a href="/Buyer/Chat/Index?userId=@adminId" class="list-group-item list-group-item-action py-3 @(activeChatId == adminId ? "active-chat" : "")">
                                <div class="d-flex align-items-center">
                                    <div class="rounded-circle bg-dark text-white d-flex align-items-center justify-content-center shadow-sm" style="width: 45px; height: 45px;">
                                        <i class="bi bi-shield-check fs-5"></i>
                                    </div>
                                    <div class="ms-3">
                                        <h6 class="mb-0 fw-bold text-dark">@adminUser.Name</h6>
                                        <small class="text-danger fw-semibold"><i class="bi bi-star-fill"></i> Admin Sàn</small>
                                    </div>
                                </div>
                            </a>
                        }
                    }

                    <div class="px-3 py-2 text-muted small fw-bold bg-white border-top border-bottom" style="letter-spacing: 1px;">LIÊN HỆ KHÁC</div>
                    @foreach (var user in allUsers.Where(u => u.Id != adminId))
                    {
                        <a href="/Buyer/Chat/Index?userId=@user.Id" class="list-group-item list-group-item-action py-3 @(activeChatId == user.Id ? "active-chat" : "")">
                            <div class="d-flex align-items-center">
                                <div class="rounded-circle bg-secondary text-white d-flex align-items-center justify-content-center" style="width: 45px; height: 45px;">
                                    <i class="bi bi-person fs-5"></i>
                                </div>
                                <div class="ms-3">
                                    <h6 class="mb-0 text-dark fw-medium">@user.Name</h6>
                                    <small class="text-muted">Cửa hàng/Khách</small>
                                </div>
                            </div>
                        </a>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-8 col-lg-9 p-0 d-flex flex-column h-100 bg-white">
            <div class="p-3 border-bottom d-flex align-items-center bg-white shadow-sm z-1">
                <div class="rounded-circle bg-dark text-white d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px;">
                    <i class="bi @(activeChatId == "AI_BOT" ? "bi-robot" : "bi-person") fs-5"></i>
                </div>
                <h5 class="mb-0 fw-bold text-dark">@ViewBag.ActiveChatName</h5>
            </div>
            
            <div class="flex-grow-1 overflow-auto p-4 custom-scrollbar" id="chatWindow" style="background-color: #f0f2f5;">
                @foreach (var msg in Model)
                {
                    bool isMine = msg.SenderId == currentUserId;
                    <div class="d-flex mb-3 @(isMine ? "justify-content-end" : "justify-content-start")">
                        <div class="p-3 rounded-4 shadow-sm" 
                             style="max-width: 75%; font-size: 14px; @(isMine ? "background-color: #111; color: white; border-bottom-right-radius: 0;" : "background-color: white; color: black; border-bottom-left-radius: 0;")">
                            @msg.Content
                            <div class="text-end mt-1 opacity-50" style="font-size: 10px;">
                                @msg.Timestamp.ToString("HH:mm")
                            </div>
                        </div>
                    </div>
                }
            </div>

            <div class="p-3 border-top bg-white">
                @if (activeChatId == "AI_BOT")
                {
                    <div class="mb-3">
                        <div class="small text-muted fw-bold mb-2"><i class="bi bi-lightning-charge-fill text-warning"></i> Câu hỏi nhanh</div>
                        <div class="d-flex flex-wrap gap-2">
                            <button type="button" class="btn btn-sm btn-outline-dark rounded-pill quick-question" data-question="Cách đặt hàng trên KIMI MARKET?">Cách đặt hàng?</button>
                            <button type="button" class="btn btn-sm btn-outline-dark rounded-pill quick-question" data-question="Làm sao để thanh toán VNPAY?">Thanh toán VNPAY</button>
                            <button type="button" class="btn btn-sm btn-outline-dark rounded-pill quick-question" data-question="Tôi muốn liên hệ Admin thì làm sao?">Liên hệ Admin</button>
                            <button type="button" class="btn btn-sm btn-outline-dark rounded-pill quick-question" data-question="Làm sao để xem lại đơn hàng?">Xem đơn hàng</button>
                            <button type="button" class="btn btn-sm btn-outline-dark rounded-pill quick-question" data-question="Cách tìm kiếm sản phẩm?">Tìm sản phẩm</button>
                            <button type="button" class="btn btn-sm btn-outline-dark rounded-pill quick-question" data-question="Tôi muốn đổi thông tin tài khoản thì làm sao?">Thông tin tài khoản</button>
                        </div>
                    </div>
                }
                <div class="input-group shadow-sm rounded-pill p-1 border">
                    <input type="text" id="messageInput" class="form-control border-0 shadow-none bg-transparent px-4 py-2" placeholder="Nhập tin nhắn..." autocomplete="off" />
                    <button id="sendButton" class="btn btn-dark rounded-pill px-4 fw-bold transition-hover">GỬI</button>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .active-chat { background-color: #e9ecef !important; border-left: 4px solid #111 !important; }
    .custom-scrollbar::-webkit-scrollbar { width: 6px; }
    .custom-scrollbar::-webkit-scrollbar-thumb { background-color: #ccc; border-radius: 10px; }
    .transition-hover:hover { transform: scale(1.05); }
</style>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
    <script>
        const currentUserId = "@currentUserId";
        const receiverId = "@activeChatId";
        const chatWindow = document.getElementById("chatWindow");
        const messageInput = document.getElementById("messageInput");
        const sendButton = document.getElementById("sendButton");

        chatWindow.scrollTop = chatWindow.scrollHeight;

        const connection = new signalR.HubConnectionBuilder().withUrl("/chatHub").build();

        function escapeHtml(value) {
            return value
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;")
                .replace(/'/g, "&#039;");
        }

        function removeTypingIndicator() {
            const typing = document.getElementById("botTypingIndicator");
            if (typing) typing.remove();
        }

        function linkifyProductDetails(value) {
            return value.replace(/(\/Buyer\/Home\/Details\?productId=\d+)/g, function (url) {
                return `<a href="${url}" class="fw-bold text-decoration-underline" target="_blank">Xem chi tiết sản phẩm</a>`;
            });
        }

        connection.on("BotTyping", function () {
            if (receiverId !== "AI_BOT") return;
            removeTypingIndicator();
            const typingHtml = `
                <div id="botTypingIndicator" class="d-flex mb-3 justify-content-start">
                    <div class="p-3 rounded-4 shadow-sm bg-white text-muted" style="max-width: 75%; font-size: 14px; border-bottom-left-radius: 0;">
                        <i class="bi bi-three-dots"></i> Trợ lý AI đang trả lời...
                    </div>
                </div>`;
            chatWindow.insertAdjacentHTML('beforeend', typingHtml);
            chatWindow.scrollTop = chatWindow.scrollHeight;
        });

        connection.on("ReceiveMessage", function (senderId, message) {
            if (senderId === receiverId || senderId === currentUserId) {
                removeTypingIndicator();
                const isMine = senderId === currentUserId;
                const alignment = isMine ? "justify-content-end" : "justify-content-start";
                const bgStyle = isMine ? "background-color: #111; color: white; border-bottom-right-radius: 0;" : "background-color: white; color: black; border-bottom-left-radius: 0;";
                const time = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
                const safeMessage = linkifyProductDetails(escapeHtml(message)).replace(/\n/g, "<br>");

                const msgHtml = `
                    <div class="d-flex mb-3 ${alignment}">
                        <div class="p-3 rounded-4 shadow-sm" style="max-width: 75%; font-size: 14px; ${bgStyle}">
                            ${safeMessage}
                            <div class="text-end mt-1 opacity-50" style="font-size: 10px;">${time}</div>
                        </div>
                    </div>`;

                chatWindow.insertAdjacentHTML('beforeend', msgHtml);
                chatWindow.scrollTop = chatWindow.scrollHeight;
            }
        });

        connection.start().catch(function (err) {
            return console.error(err.toString());
        });

        function sendCurrentMessage() {
            const message = messageInput.value;
            if (message.trim() !== "") {
                connection.invoke("SendMessage", currentUserId, receiverId, message).catch(function (err) {
                    return console.error(err.toString());
                });
                messageInput.value = "";
                messageInput.focus();
            }
        }

        sendButton.addEventListener("click", function (event) {
            sendCurrentMessage();
            event.preventDefault();
        });

        document.querySelectorAll(".quick-question").forEach(function (button) {
            button.addEventListener("click", function () {
                messageInput.value = this.dataset.question;
                sendCurrentMessage();
            });
        });

        messageInput.addEventListener("keypress", function (e) {
            if (e.key === 'Enter') {
                sendButton.click();
            }
        });
    </script>
}
