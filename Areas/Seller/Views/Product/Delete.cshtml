@model ĐồÁnCơSở.Models.Product

@{
    ViewData["Title"] = "Xóa sản phẩm";
}

<div class="container mt-5 mb-5 d-flex justify-content-center">
    <div class="card shadow-lg border-0 rounded-4" style="max-width: 800px; width: 100%;">
        <div class="card-header text-white py-3 rounded-top-4" style="background-color: #dc3545;">
            <h4 class="mb-0 fw-bold"><i class="bi bi-exclamation-triangle-fill me-2"></i> Xác nhận xóa sản phẩm</h4>
        </div>
        
        <div class="card-body p-5">
            <form method="post" asp-action="Delete">
                <input asp-for="Id" hidden />
                <input asp-for="ImageUrl" hidden />
                
                <h5 class="text-center mb-4 text-dark">Bạn có chắc chắn muốn xóa vĩnh viễn sản phẩm này không?</h5>
                
                <div class="row align-items-center bg-light p-4 rounded-4 border mb-4">
                    <div class="col-md-3 text-center mb-3 mb-md-0">
                        <img src="@Model.ImageUrl" class="rounded-3 shadow-sm" style="width: 100%; max-width: 150px; height: auto; object-fit: cover;" onerror="this.src='/images/no-image.png'" />
                    </div>
                    <div class="col-md-9">
                        <div class="mb-2">
                            <span class="text-muted small text-uppercase fw-bold">Tên sản phẩm</span>
                            <h5 class="fw-bold text-dark mb-0">@Model.Name</h5>
                        </div>
                        <div class="row mt-3">
                            <div class="col-6">
                                <span class="text-muted small text-uppercase fw-bold">Giá bán</span>
                                <h6 class="fw-bold text-danger mb-0">@Model.Price.ToString("N0") VNĐ</h6>
                            </div>
                            <div class="col-6">
                                <span class="text-muted small text-uppercase fw-bold">Danh mục</span>
                                <h6 class="fw-bold text-dark mb-0"><span class="badge bg-secondary">@Model.Category?.Name</span></h6>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-center gap-3 mt-4">
                    <a asp-controller="Product" asp-action="Index" class="btn btn-outline-dark rounded-pill px-5 fw-bold py-2">
                        <i class="bi bi-arrow-left me-1"></i> Quay lại
                    </a>
                    <button type="submit" class="btn btn-danger rounded-pill px-5 fw-bold py-2 shadow-sm">
                        <i class="bi bi-trash-fill me-1"></i> Xác nhận Xóa
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>