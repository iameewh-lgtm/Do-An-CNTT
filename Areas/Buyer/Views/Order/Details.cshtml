@model ĐồÁnCơSở.Models.OrderVM

@{
    ViewData["Title"] = "Chi tiết đơn hàng #" + Model.OrderHeader.Id;
    
    // Thuật toán: Dùng Convert.ToDouble để dập tắt hoàn toàn lỗi xung đột kiểu dữ liệu
    double displayTotal = Convert.ToDouble(Model.OrderHeader.OrderTotal);
    if (User.IsInRole("Seller") && !User.IsInRole("Admin"))
    {
        displayTotal = Model.OrderDetails.Sum(x => Convert.ToDouble(x.Price) * x.Count);
    }
}

<div class="container mt-5 mb-5">
    <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
        <div class="card-header bg-dark text-white py-4 px-4 border-0">
            <h4 class="mb-0" style="font-family: 'Playfair Display', serif; letter-spacing: 1px;">
                <i class="bi bi-receipt me-2"></i> CHI TIẾT ĐƠN HÀNG #@Model.OrderHeader.Id
            </h4>
        </div>
        <div class="card-body p-5">
            <div class="row">
                <div class="col-12 col-lg-6 pe-lg-5 border-end">
                    <h5 class="fw-bold mb-4 text-uppercase text-muted" style="letter-spacing: 1px;">Thông tin giao hàng</h5>
                    <div class="mb-3 d-flex justify-content-between align-items-center border-bottom pb-2">
                        <span class="text-muted">Họ tên khách hàng:</span>
                        <div>
                            <span class="fw-bold me-2">@Model.OrderHeader.Name</span>
                            @if (User.IsInRole("Seller") || User.IsInRole("Admin"))
                            {
                                <a href="/Buyer/Chat/Index?userId=@Model.OrderHeader.ApplicationUserId" class="btn btn-sm btn-dark rounded-pill py-0 px-2" style="font-size: 11px;"><i class="bi bi-chat-dots"></i> Chat</a>
                            }
                        </div>
                    </div>
                    <div class="mb-3 d-flex justify-content-between border-bottom pb-2">
                        <span class="text-muted">Số điện thoại:</span>
                        <span class="fw-bold">@Model.OrderHeader.PhoneNumber</span>
                    </div>
                    <div class="mb-3 d-flex justify-content-between border-bottom pb-2">
                        <span class="text-muted">Ngày đặt:</span>
                        <span class="fw-bold">@Model.OrderHeader.OrderDate.ToString("dd/MM/yyyy HH:mm")</span>
                    </div>
                    <div class="mb-3 d-flex justify-content-between border-bottom pb-2">
                        <span class="text-muted">Trạng thái:</span>
                        <span class="badge bg-dark rounded-pill px-3 py-1">@Model.OrderHeader.OrderStatus</span>
                    </div>
                    <div class="mb-4 bg-light p-3 rounded-3 mt-3">
                        <strong class="d-block mb-1 text-muted small text-uppercase">Địa chỉ nhận hàng:</strong>
                        <span class="fw-medium">@Model.OrderHeader.StreetAddress, @Model.OrderHeader.Ward, @Model.OrderHeader.District, @Model.OrderHeader.City</span>
                    </div>

                    @if (User.IsInRole("Admin"))
                    {
                        <div class="mt-5 p-4 bg-white rounded-4 shadow-sm border">
                            <h6 class="fw-bold mb-3 text-dark"><i class="bi bi-sliders me-2"></i> Cập nhật trạng thái</h6>
                            <form method="post" asp-action="UpdateStatus">
                                <input type="hidden" name="orderId" value="@Model.OrderHeader.Id" />
                                <div class="input-group">
                                    <select name="status" class="form-select border-dark shadow-none rounded-start-pill px-4">
                                        <option value="Đã thanh toán" selected="@(Model.OrderHeader.OrderStatus == "Đã thanh toán")">Đã thanh toán</option>
                                        <option value="Đang giao hàng" selected="@(Model.OrderHeader.OrderStatus == "Đang giao hàng")">Đang giao hàng</option>
                                        <option value="Đã hoàn thành" selected="@(Model.OrderHeader.OrderStatus == "Đã hoàn thành")">Đã hoàn thành</option>
                                        <option value="Đã hủy" selected="@(Model.OrderHeader.OrderStatus == "Đã hủy")">Đã hủy</option>
                                    </select>
                                    <button type="submit" class="btn btn-dark rounded-end-pill px-4">Cập nhật</button>
                                </div>
                            </form>
                        </div>
                    }
                </div>

                <div class="col-12 col-lg-6 ps-lg-5 mt-5 mt-lg-0">
                    <h5 class="fw-bold mb-4 text-uppercase text-muted" style="letter-spacing: 1px;">Sản phẩm đã đặt</h5>
                    <div class="table-responsive mb-4">
                        <table class="table table-borderless align-middle">
                            <thead class="border-bottom">
                                <tr>
                                    <th class="text-muted fw-normal pb-3">Sản phẩm</th>
                                    <th class="text-center text-muted fw-normal pb-3">SL</th>
                                    <th class="text-end text-muted fw-normal pb-3">Thành tiền</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.OrderDetails)
                                {
                                    <tr class="border-bottom">
                                        <td class="py-3">
                                            <span class="fw-bold d-block text-dark">@item.Product.Name</span>
                                            @if (!User.IsInRole("Admin") && !User.IsInRole("Seller"))
                                            {
                                                <a href="/Buyer/Chat/Index?userId=@item.Product.SellerId" class="text-decoration-none" style="font-size: 11px; color: #ff5000;">
                                                    <i class="bi bi-shop"></i> Chat với Shop
                                                </a>
                                            }
                                        </td>
                                        <td class="text-center py-3">x@(item.Count)</td>
                                        <td class="text-end fw-bold py-3">@((item.Price * item.Count).ToString("N0")) ₫</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="bg-light p-4 rounded-4 mt-4">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Giá trị hàng hóa:</span>
                            <span class="fw-bold">@displayTotal.ToString("N0") ₫</span>
                        </div>
                        <div class="d-flex justify-content-between mb-3 pb-3 border-bottom">
                            <span class="text-muted">Phí vận chuyển:</span>
                            <span class="fw-bold text-success">Miễn phí</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="h6 fw-bold mb-0 text-uppercase">@(User.IsInRole("Seller") ? "Phần của Shop" : "Tổng thanh toán")</span>
                            <span class="h3 fw-bold mb-0" style="color: #111;">@displayTotal.ToString("N0") ₫</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="card-footer bg-white border-top py-4 px-5 text-end">
            <a asp-action="Index" class="btn btn-outline-dark rounded-pill px-5 py-2 fw-bold transition-hover">
                <i class="bi bi-arrow-left me-2"></i> Quay lại
            </a>
        </div>
    </div>
</div>