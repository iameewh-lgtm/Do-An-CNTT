@model ĐồÁnCơSở.Models.ShoppingCartVM

<div class="container p-3 mt-4">
    <div class="card shadow border-0">
        <div class="card-header bg-primary bg-gradient text-light py-4">
            <div class="row px-4">
                <div class="col-6">
                    <h5 class="pt-2 text-white text-uppercase"><i class="bi bi-cart-fill"></i> Giỏ Hàng Của bạn</h5>
                </div>
                <div class="col-6 text-end">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-light btn-sm text-uppercase">Mua tiếp nghen</a>
                </div>
            </div>
        </div>
        <div class="card-body">
            @if (Model.ListCart.Count() > 0)
            {
                @foreach (var item in Model.ListCart)
                {
                    <div class="row border-bottom pb-3 pt-3">
                        <div class="d-none d-lg-block col-lg-1 text-center py-2">
                            <img src="@item.Product.ImageUrl" class="rounded" width="100%" />
                        </div>
                        <div class="col-12 col-lg-6 pt-md-3">
                            <h5 class="text-uppercase text-secondary"><strong>@item.Product.Name</strong></h5>
                            <p><small>@Html.Raw(item.Product.Description)</small></p>
                        </div>
                        <div class="col-12 col-lg-5 text-center row">
                            <div class="col-4 text-md-right pt-2 pt-md-4">
                                <h6 class="fw-bold">@item.Product.Price.ToString("N0") <span class="text-muted">&nbsp;x&nbsp;</span>@item.Count</h6>
                            </div>
                            <div class="col-6 col-sm-4 col-lg-6 pt-2">
                                <div class="w-75 btn-group" role="group">
                                    <a asp-action="Plus" asp-route-cartId="@item.Id" class="btn btn-outline-primary bg-gradient py-2 rounded-start">
                                        <i class="bi bi-plus-square"></i>
                                    </a>
                                    <span class="btn btn-light disabled py-2 px-3 fw-bold">@item.Count</span>
                                    <a asp-action="Minus" asp-route-cartId="@item.Id" class="btn btn-outline-primary bg-gradient py-2 rounded-end">
                                        <i class="bi bi-dash-square"></i>
                                    </a>
                                </div>
                            </div>
                            <div class="col-2 col-sm-4 col-lg-2 text-right pt-2">
                                <a asp-action="Remove" asp-route-cartId="@item.Id" class="btn btn-outline-danger bg-gradient py-2">
                                    <i class="bi bi-trash-fill"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                }

                <div class="card-footer bg-white border-0">
                    <div class="row">
                        <div class="col-md-4 offset-md-8 text-end">
                            <ul class="list-group">
                                <li class="list-group-item d-flex justify-content-between bg-light">
                                    <span class="text-info fw-bold">Tổng tiền (VNĐ)</span>
                                    <strong class="text-danger fs-4">@Model.OrderTotal.ToString("N0") đ</strong>
                                </li>
                            </ul>
                            <a asp-action="Summary" class="btn btn-success bg-gradient w-100 py-2 mt-3 text-uppercase fw-bold">
                                Chốt Đơn Thanh Toán
                            </a>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="text-center p-5">
                    <h4 class="text-muted">Giỏ hàng trống lỏng trống lơ à bạn ơi!</h4>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-3">Ra chợ mua đồ liền</a>
                </div>
            }
        </div>
    </div>
</div>