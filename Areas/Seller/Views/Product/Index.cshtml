@model IEnumerable<ĐồÁnCơSở.Models.Product>

<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-dark">Quản lý Sản phẩm</h2>
        <a asp-action="Upsert" class="btn text-white fw-bold shadow-sm" style="background-color: #ff5000; border-radius: 50px; padding: 10px 25px;">
            <i class="bi bi-plus-circle me-1"></i> Thêm sản phẩm
        </a>
    </div>

    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body p-4">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th scope="col" class="rounded-start">Ảnh</th>
                            <th scope="col">Tên sản phẩm</th>
                            <th scope="col">Danh mục</th>
                            <th scope="col">Giá bán</th>
                            <th scope="col">Tồn kho</th>
                            <th scope="col" class="rounded-end text-center">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        @* Chống sập do lỗi đường dẫn ảnh *@
                                        <img src="@item.ImageUrl" style="width: 60px; height: 60px; object-fit: cover; border-radius: 8px;" onerror="this.src='/images/no-image.png'" />
                                    </td>
                                    <td class="fw-bold text-dark">@item.Name</td>
                                    
                                    @* Chống sập do lỗi không tìm thấy tên danh mục *@
                                    <td>
                                        <span class="badge bg-secondary">@(item.Category != null ? item.Category.Name : "Chưa phân loại")</span>
                                    </td>
                                    
                                    <td class="text-danger fw-bold">@item.Price.ToString("N0") đ</td>
                                    <td>@item.Stock</td>
                                    <td class="text-center">
                                        <div class="btn-group shadow-sm">
                                            <a asp-action="Upsert" asp-route-id="@item.Id" class="btn btn-sm btn-outline-dark fw-bold px-3">
                                                <i class="bi bi-pencil-square"></i> Sửa
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger fw-bold px-3">
                                                <i class="bi bi-trash"></i> Xóa
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted py-5">
                                    <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                    Bạn chưa đăng sản phẩm nào. Hãy bấm "Thêm sản phẩm" nhé!
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>